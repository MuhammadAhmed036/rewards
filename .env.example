# Database Connection (Postgres 16, default port 5434 for docker-compose)
DATABASE_URL=postgres://loyalty_app:loyalty_password@localhost:5434/loyalty_db
DATABASE_URL_UNPOOLED=postgres://loyalty_app:loyalty_password@localhost:5434/loyalty_db

# Application URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LoyaltyPlatform

# Secrets (Minimum 32 bytes)
AUTH_SECRET=dev_auth_secret_must_be_at_least_32_characters_long_12345
QR_SIGNING_SECRET=dev_qr_signing_secret_must_be_at_least_32_characters_12345
CRON_SECRET=dev_cron_secret_must_be_at_least_32_characters_long_12345

# Authentication Providers
GOOGLE_CLIENT_ID=dev_mock_google_client_id
GOOGLE_CLIENT_SECRET=dev_mock_google_client_secret

# Email (Resend in prod, local outbox / Mailpit in dev)
RESEND_API_KEY=re_mock_api_key_12345
EMAIL_FROM_TRANSACTIONAL=no-reply@app.example.com

# Rate Limiting (Upstash Redis or Postgres fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Observability (Sentry)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Node Environment
NODE_ENV=development

