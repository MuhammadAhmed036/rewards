# Copy this file to .env and fill in real values before running docker-compose.vm.yml.
# Generate each secret with: openssl rand -hex 32

# Postgres password for the app's database user (pick your own, don't reuse this file's values)
POSTGRES_PASSWORD=

# Public URL the app will be reached at. Must be https:// — Caddy terminates TLS on :443 (see
# DEPLOYMENT.md). e.g. https://203.0.113.10 or https://rewards.yourdomain.com
APP_URL=https://localhost
APP_DOMAIN=example.com
APP_NAME=Rappio

# Session, QR-code and scheduled-job secrets — 32+ random characters each, all different
AUTH_SECRET=
QR_SIGNING_SECRET=
CRON_SECRET=

# Optional: real Google OAuth credentials. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
